// A tour of every construct in the Nex v0.1 language sketch.
// This file is not runnable yet; it exists to exercise the lexer and parser.

struct Point {
    x: f64,
    y: f64,
}

enum Option<T> {
    Some(T),
    None,
}

const MAX: i32 = 100;

fn add(a: i32, b: i32) -> i32 {
    return a + b;
}

fn classify(n: i32) -> str {
    if n > MAX {
        return "big";
    } else {
        return "small";
    }
}

fn main() {
    let x = 5;
    let mut total = 0;
    let ratio = 2.5e-3;
    let mask = 0xFF & 0b1010;
    let big = 1_000_000;

    for i in 0..10 {
        total += add(i, x);
    }

    while total > 0 {
        total -= 1;
    }

    let p = Point { x: 1.0, y: 2.0 };
    print(p.x);

    match Option::Some(x) {
        Option::Some(v) => print(v),
        Option::None => print("none"),
    }

    print(classify(big));
    print("tabs\tand\nnewlines\x21");
}
